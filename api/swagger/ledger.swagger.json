{
  "swagger": "2.0",
  "info": {
    "title": "api/proto/v1/ledger.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "LedgerService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/ledger/accounts/balance": {
      "post": {
        "operationId": "LedgerService_ListAccountBalances",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAccountBalancesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Every filter is optional; supplying none returns the Trial balance.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ListAccountBalancesRequest"
            }
          }
        ],
        "tags": [
          "LedgerService"
        ]
      }
    },
    "/v1/ledger/postings/query": {
      "post": {
        "operationId": "LedgerService_ListPostings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPostingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ListPostingsRequest"
            }
          }
        ],
        "tags": [
          "LedgerService"
        ]
      }
    },
    "/v1/ledger/transactions": {
      "post": {
        "operationId": "LedgerService_RecordTransaction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RecordTransactionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RecordTransactionRequest"
            }
          }
        ],
        "tags": [
          "LedgerService"
        ]
      }
    },
    "/v1/ledger/transactions/query": {
      "post": {
        "operationId": "LedgerService_ListTransactions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListTransactionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ListTransactionsRequest"
            }
          }
        ],
        "tags": [
          "LedgerService"
        ]
      }
    }
  },
  "definitions": {
    "RecordTransactionRequestPostingInput": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "amount": {
          "$ref": "#/definitions/typeMoney"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "typeMoney": {
      "type": "object",
      "properties": {
        "currencyCode": {
          "type": "string",
          "description": "The three-letter currency code defined in ISO 4217."
        },
        "units": {
          "type": "string",
          "format": "int64",
          "description": "The whole units of the amount.\nFor example if `currencyCode` is `\"USD\"`, then 1 unit is one US dollar."
        },
        "nanos": {
          "type": "integer",
          "format": "int32",
          "description": "Number of nano (10^-9) units of the amount.\nThe value must be between -999,999,999 and +999,999,999 inclusive.\nIf `units` is positive, `nanos` must be positive or zero.\nIf `units` is zero, `nanos` can be positive, zero, or negative.\nIf `units` is negative, `nanos` must be negative or zero.\nFor example $-1.75 is represented as `units`=-1 and `nanos`=-750,000,000."
        }
      },
      "description": "Represents an amount of money with its currency type."
    },
    "v1Account": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/v1AccountType"
        },
        "user": {
          "type": "string",
          "description": "Free-form owner label. Never an authenticated identity."
        },
        "name": {
          "type": "string",
          "description": "Opaque label, e.g. \"Checking\". Never split, never rolled up."
        }
      },
      "description": "An Account is identified by the exact composite (type, user, name). There is\nno hierarchy, no wildcard and no roll-up: `name` is opaque and every field is\nmatched exactly. See docs/adr/0002-flat-account-names.md."
    },
    "v1AccountBalance": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "balance": {
          "$ref": "#/definitions/typeMoney"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1AccountFilter": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/v1AccountType",
          "description": "Unspecified means \"not filtered\": no Account carries it."
        },
        "user": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "description": "An AccountFilter narrows a read to the Accounts whose fields match it\nexactly. A field it leaves unset is not filtered on at all; a field it sets\nto the empty string matches only the empty string, so an Account with no\nuser can be asked for on its own. Nothing here is ever a wildcard."
    },
    "v1AccountType": {
      "type": "string",
      "enum": [
        "ACCOUNT_TYPE_UNSPECIFIED",
        "ACCOUNT_TYPE_ASSETS",
        "ACCOUNT_TYPE_LIABILITIES",
        "ACCOUNT_TYPE_EQUITIES",
        "ACCOUNT_TYPE_INCOMES",
        "ACCOUNT_TYPE_EXPENSES"
      ],
      "default": "ACCOUNT_TYPE_UNSPECIFIED"
    },
    "v1ListAccountBalancesRequest": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1AccountFilter"
        },
        "currencyCode": {
          "type": "string"
        }
      },
      "description": "Every filter is optional; supplying none returns the Trial balance."
    },
    "v1ListAccountBalancesResponse": {
      "type": "object",
      "properties": {
        "balances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AccountBalance"
          }
        }
      }
    },
    "v1ListPostingsRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1PostingFilter"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "Defaults to 10, clamped to at most 100."
        },
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "description": "One-based; below one is the first page."
        },
        "orderByAscending": {
          "type": "boolean",
          "description": "Oldest Transaction date first. Default is newest first."
        }
      }
    },
    "v1ListPostingsResponse": {
      "type": "object",
      "properties": {
        "postings": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Posting"
          }
        },
        "totalCount": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1ListTransactionsRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1TransactionFilter"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "Defaults to 10, clamped to at most 100."
        },
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "description": "One-based; below one is the first page."
        },
        "orderByAscending": {
          "type": "boolean",
          "description": "Oldest Transaction date first. Default is newest first."
        }
      }
    },
    "v1ListTransactionsResponse": {
      "type": "object",
      "properties": {
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Transaction"
          }
        },
        "totalCount": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1Posting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "transactionId": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/v1Account"
        },
        "amount": {
          "$ref": "#/definitions/typeMoney"
        },
        "balance": {
          "$ref": "#/definitions/typeMoney",
          "description": "Running balance of the Account after this leg."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction date: supplied by the caller or stamped by the ledger."
        }
      }
    },
    "v1PostingFilter": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1AccountFilter"
        },
        "currencyCode": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction date, inclusive."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction date, exclusive."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Matched against the parent Transaction's metadata — a Posting has none of\nits own. Same exact-pair rule as on the Transaction listing."
        }
      },
      "description": "A Register read: one Account's Postings over time. Every filter is optional\nand the date range is half-open, as on the Transaction listing."
    },
    "v1RecordTransactionRequest": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "postings": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/RecordTransactionRequestPostingInput"
          }
        },
        "verifyNonNegativeBalances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Account"
          }
        }
      }
    },
    "v1RecordTransactionResponse": {
      "type": "object",
      "properties": {
        "transaction": {
          "$ref": "#/definitions/v1Transaction"
        }
      }
    },
    "v1Transaction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "postings": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Posting"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1TransactionFilter": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "description": "Exact; matches at most one Transaction."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction date, inclusive."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction date, exclusive."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact metadata pairs the Transaction has to carry. Every pair given has\nto match, key and value; a Transaction carrying more is still a match. An\nempty key is refused."
        }
      },
      "description": "Every filter is optional. The date range is half-open: start_date is\nincluded and end_date is excluded, so adjacent periods never double-count."
    }
  }
}
